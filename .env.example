# =======================================================================
# RideFlow - Cab Booking Application Environment Variables Template
# Copy this file to .env or set these in your local environment.
# =======================================================================

# Database Configuration (PostgreSQL / Supabase)
DB_URL=jdbc:postgresql://localhost:5432/cabbooking
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_length_here
JWT_EXPIRATION=3600000

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
